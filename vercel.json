{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://api.helixa.xyz data:; connect-src 'self' https://api.dexscreener.com https://api.coingecko.com https://x402.org https://mainnet.base.org https://base.llamarpc.com https://base.drpc.org https://base.publicnode.com https://1rpc.io; frame-src 'self' blob: https://sibylcap.com https://partners.sibylcap.com"
        }
      ]
    },
    {
      "source": "/images/_sp_9709968e2e12062a\\.(pdf|svg)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(style\\.css|script\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/files/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/claim",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/partners/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "partners.sibylcap.com" }], "destination": "/partners/index.html" },
    { "source": "/dashboard", "has": [{ "type": "host", "value": "partners.sibylcap.com" }], "destination": "/partners/dashboard.html" },
    { "source": "/messages", "has": [{ "type": "host", "value": "partners.sibylcap.com" }], "destination": "/partners/messages.html" },
    { "source": "/vest", "has": [{ "type": "host", "value": "partners.sibylcap.com" }], "destination": "/partners/vest.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "claim.sibylcap.com" }], "destination": "/claim.html" },
    { "source": "/", "has": [{ "type": "host", "value": "blog.sibylcap.com" }], "destination": "/blog/index.html" },
    { "source": "/:slug", "has": [{ "type": "host", "value": "blog.sibylcap.com" }], "destination": "/blog/:slug.html" }
  ],
  "redirects": [
    { "source": "/ping", "destination": "https://ping.sibylcap.com", "permanent": true },
    { "source": "/memory", "destination": "https://sibyllabs.org/memory", "permanent": true },
    { "source": "/blog", "has": [{ "type": "host", "value": "sibylcap.com" }], "destination": "https://blog.sibylcap.com", "permanent": true },
    { "source": "/blog/:slug*", "has": [{ "type": "host", "value": "sibylcap.com" }], "destination": "https://blog.sibylcap.com/:slug*", "permanent": true },
    { "source": "/api/plugin/:path*", "destination": "https://api.sibyllabs.org/api/plugin/:path*", "permanent": true },
    { "source": "/sibyl-vs-honcho", "has": [{ "type": "host", "value": "blog.sibylcap.com" }], "destination": "https://blog.sibylcap.com/beta-analysis", "permanent": true },
    { "source": "/sibyl-vs-mem0", "has": [{ "type": "host", "value": "blog.sibylcap.com" }], "destination": "https://blog.sibylcap.com/beta-analysis-v2", "permanent": true }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
